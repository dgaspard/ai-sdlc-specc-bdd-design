{
  "name": "ai-sdlc-petclinic",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A clean-room PetClinic demo showing executable specifications in the AI SDLC.",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "npm run verify",
    "test:bdd": "cucumber-js",
    "test:bdd:headed": "HEADED=true cucumber-js",
    "test:contract": "node --test tests/contracts/visit-cancellation.contract.test.js",
    "test:observability": "node --test tests/observability/visit-cancellation.observability.test.js",
    "verify": "npm run test:bdd && npm run test:contract && npm run test:observability"
  },
  "engines": {
    "node": "22 || 24 || >=26"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "express": "5.1.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.2.1",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@playwright/test": "1.55.1",
    "ajv": "8.20.0"
  },
  "allowScripts": {
    "fsevents@2.3.2": true
  }
}
