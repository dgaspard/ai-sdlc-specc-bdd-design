{
  "name": "ai-sdlc-petclinic",
  "version": "1.0.0",
  "private": true,
  "description": "Specification-first PetClinic demo: an AI agent builds four services from protected BDD, API, schema, and observability tests.",
  "scripts": {
    "test": "npm --prefix spec test",
    "test:engineering": "node --test --test-concurrency=1 tools/*.test.mjs",
    "trace:payment": "node tools/capture-payment-trace.mjs",
    "demo:journey": "spec/node_modules/.bin/playwright test --config tools/demo/playwright.demo.config.mjs",
    "lint": "services/platform/node_modules/.bin/eslint services frontend tools eslint.config.mjs",
    "format:check": "services/platform/node_modules/.bin/prettier --check 'services/**/*.js' 'services/**/package.json' 'frontend/*.js' 'frontend/package.json' 'tools/**/*.mjs' eslint.config.mjs package.json",
    "format": "services/platform/node_modules/.bin/prettier --write 'services/**/*.js' 'services/**/package.json' 'frontend/*.js' 'frontend/package.json' 'tools/**/*.mjs' eslint.config.mjs package.json",
    "check": "npm run lint && npm run format:check"
  },
  "engines": {
    "node": "22 || 24 || >=26"
  }
}
