# CTL-031: no IAM statement allows "*" or "<service>:*". AC-6 (least privilege).

let iam_policies = Resources.*[ Type in [ 'AWS::IAM::Policy', 'AWS::IAM::ManagedPolicy' ] ]
let iam_roles_with_inline = Resources.*[ Type == 'AWS::IAM::Role'
                                         Properties.Policies exists ]

rule no_wildcard_actions_in_policies when %iam_policies !empty {
    # A Deny-only policy is applicable and valid, not skipped by the Allow filter.
    %iam_policies.Properties.PolicyDocument.Statement exists
    %iam_policies.Properties.PolicyDocument.Statement[ Effect == 'Allow' ] {
        when Action is_string { Action != /\*$/ }
        when Action is_list { Action[*] != /\*$/ }
    }
}

rule no_wildcard_actions_in_role_policies when %iam_roles_with_inline !empty {
    %iam_roles_with_inline.Properties.Policies[*].PolicyDocument.Statement exists
    %iam_roles_with_inline.Properties.Policies[*].PolicyDocument.Statement[ Effect == 'Allow' ] {
        when Action is_string { Action != /\*$/ }
        when Action is_list { Action[*] != /\*$/ }
    }
}
