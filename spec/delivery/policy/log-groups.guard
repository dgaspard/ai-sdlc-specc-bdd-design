# CTL-030: containers log to KMS-encrypted CloudWatch log groups that expire.
# AU-9 (protect audit information), AU-11 (retention), cost (no unbounded storage).

let log_groups = Resources.*[ Type == 'AWS::Logs::LogGroup' ]
let task_defs = Resources.*[ Type == 'AWS::ECS::TaskDefinition' ]

rule log_groups_encrypted_and_expire when %log_groups !empty {
    %log_groups.Properties.KmsKeyId exists
    %log_groups.Properties.RetentionInDays exists
    %log_groups.Properties.RetentionInDays <= 30
}

rule containers_send_logs_to_cloudwatch when %task_defs !empty {
    %task_defs.Properties.ContainerDefinitions[*].LogConfiguration.LogDriver == 'awslogs'
}
