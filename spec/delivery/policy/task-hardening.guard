# CTL-032: ECS tasks run on Fargate, as non-root, with a read-only root file system,
# never privileged. CM-7 (least functionality), AC-6. Mirrors CTL-002 for the image.

let task_defs = Resources.*[ Type == 'AWS::ECS::TaskDefinition' ]

rule tasks_run_on_fargate when %task_defs !empty {
    %task_defs.Properties.RequiresCompatibilities[*] == 'FARGATE'
}

rule containers_are_hardened when %task_defs !empty {
    %task_defs.Properties.ContainerDefinitions[*] {
        ReadonlyRootFilesystem == true
        User exists
        User !in [ 'root', '0', '0:0' ]
        Privileged !exists or Privileged == false
    }
}
