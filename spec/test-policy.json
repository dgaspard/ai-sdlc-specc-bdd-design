{
  "description": "PERF-03 test policy: which suites exist, which tiers run them, and which changed paths select them. Protected: humans own what counts as tested. Read by spec/run-all.js.",
  "suites": {
    "guard":         { "name": "Guard (protected specs and tests)", "cmd": "node", "args": ["guard/check.js"] },
    "harness":       { "name": "Harness self-checks", "cmd": "node", "args": ["--test", "--test-reporter=spec", "--test-concurrency=1", "tests/harness/**/*.test.js"] },
    "schema":        { "name": "Schema contracts", "cmd": "node", "args": ["--test", "--test-reporter=spec", "--test-concurrency=1", "tests/contract/**/*.test.js"] },
    "runtime":       { "name": "Runtime contract", "cmd": "node", "args": ["--test", "--test-reporter=spec", "--test-concurrency=1", "tests/runtime/**/*.test.js"] },
    "auth":          { "name": "Authentication", "cmd": "node", "args": ["--test", "--test-reporter=spec", "--test-concurrency=1", "tests/auth/**/*.test.js"] },
    "observability": { "name": "Observability (OpenTelemetry)", "cmd": "node", "args": ["--test", "--test-reporter=spec", "--test-concurrency=1", "tests/observability/**/*.test.js"] },
    "features":      { "name": "Service features (Cucumber)", "cmd": "npx", "args": ["cucumber-js"],
                       "scopeByService": { "args": ["cucumber-js", "features/{service}/*.feature"] } },
    "workflows":     { "name": "Backend journeys (Playwright HTTP)", "cmd": "npx", "args": ["cucumber-js", "--profile", "workflows"] },
    "browser":       { "name": "Frontend journeys (headless Chromium)", "cmd": "npx", "args": ["playwright", "test", "--config", "tests/browser/playwright.config.js"] },
    "performance":   { "name": "Local performance", "cmd": "node", "args": ["--test", "--test-reporter=spec", "--test-concurrency=1", "tests/performance/*.test.js"] }
  },
  "tiers": {
    "fast": {
      "purpose": "Inner loop while building. Runs the always-set plus suites selected by paths changed since the last verified tree. Does not make work complete.",
      "always": ["guard", "harness", "schema"]
    },
    "full": {
      "purpose": "The gate. Every suite must pass on the exact working tree before work is complete, a commit is pushed, or a PR merges.",
      "suites": ["guard", "harness", "schema", "runtime", "auth", "observability", "features", "workflows", "browser", "performance"]
    }
  },
  "rules": {
    "description": "First matching rule wins. A path ending in / matches everything under it; any other path matches exactly. {service} is bound from the matched folder. A changed path that matches no rule selects every suite.",
    "list": [
      { "paths": ["spec/", "docs/specs/", ".github/", ".claude/", "AGENTS.md", "package.json", "package-lock.json", "eslint.config.mjs", "services/platform/"], "suites": "all" },
      { "paths": ["services/{service}/"], "suites": ["runtime", "auth", "observability", "features", "workflows", "browser"], "scoped": ["features"] },
      { "paths": ["frontend/"], "suites": ["runtime", "browser"] },
      { "paths": ["docs/", "tools/", "README.md", "BACKLOG.md", "PROJECT-PLAN.md", ".gitignore"], "suites": [] }
    ]
  }
}
