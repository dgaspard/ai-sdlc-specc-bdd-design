{
  "openapi": "3.1.0",
  "info": {
    "title": "PetClinic demo authentication",
    "version": "1.0.0",
    "description": "Demo-only authentication (PROJECT-PLAN A-09, spec/contracts/auth-contract.md). Login is served by the Customer service. Tokens are JWT signed with HS256 using AUTH_TOKEN_SECRET."
  },
  "paths": {
    "/auth/login": {
      "post": {
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "common.openapi.json#/components/responses/BadRequest"
          },
          "401": {
            "description": "Unknown username or wrong password; identical problem for both (code unauthenticated)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "common.openapi.json#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Uuid": {
        "type": "string",
        "format": "uuid"
      },
      "Role": {
        "enum": [
          "veterinarian",
          "customer",
          "service",
          "administrator"
        ]
      },
      "Roles": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Role"
        },
        "minItems": 2,
        "uniqueItems": true,
        "description": "MVP-02A (D-44): present only for an account holding more than one role (today, exactly one account: the clinic owner, holding veterinarian and administrator). The singular 'role' property stays the account's primary role for backward compatibility with single-role accounts and existing checks; 'roles', when present, is the full set. Authorization passes if the required role equals 'role' or appears in 'roles'."
      },
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "User": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "username",
          "role",
          "displayName"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "username": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "veterinarian",
              "customer",
              "administrator"
            ]
          },
          "roles": {
            "$ref": "#/components/schemas/Roles"
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "customerId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "veterinarianId": {
            "$ref": "#/components/schemas/Uuid"
          }
        },
        "description": "MVP-02A: 'administrator' is a valid primary role on its own (an admin-only account with no veterinarianId/customerId), distinct from the dual-role case where 'role' stays 'veterinarian' and 'roles' additionally includes 'administrator' (D-40, D-44).",
        "allOf": [
          {
            "if": {
              "properties": {
                "role": {
                  "const": "customer"
                }
              }
            },
            "then": {
              "required": [
                "customerId"
              ],
              "not": {
                "required": [
                  "veterinarianId"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "role": {
                  "const": "veterinarian"
                }
              }
            },
            "then": {
              "required": [
                "veterinarianId"
              ],
              "not": {
                "required": [
                  "customerId"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "role": {
                  "const": "administrator"
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  { "required": ["customerId"] },
                  { "required": ["veterinarianId"] }
                ]
              }
            }
          }
        ]
      },
      "LoginResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "token",
          "user"
        ],
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "description": "user never includes the password."
      },
      "TokenHeader": {
        "type": "object",
        "required": [
          "alg",
          "typ"
        ],
        "properties": {
          "alg": {
            "const": "HS256"
          },
          "typ": {
            "const": "JWT"
          }
        }
      },
      "TokenClaims": {
        "type": "object",
        "required": [
          "sub",
          "role",
          "iat",
          "exp"
        ],
        "properties": {
          "sub": {
            "type": "string",
            "minLength": 1,
            "description": "User id, or the calling service's name for role service"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "roles": {
            "$ref": "#/components/schemas/Roles"
          },
          "customerId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "veterinarianId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "iat": {
            "type": "integer",
            "description": "Seconds since epoch, from the clinic clock"
          },
          "exp": {
            "type": "integer",
            "description": "iat + 28800 for users; iat + 300 for services"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "role": {
                  "const": "customer"
                }
              }
            },
            "then": {
              "required": [
                "customerId"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "role": {
                  "const": "veterinarian"
                }
              }
            },
            "then": {
              "required": [
                "veterinarianId"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "role": {
                  "const": "service"
                }
              }
            },
            "then": {
              "properties": {
                "sub": {
                  "enum": [
                    "customer",
                    "reservation",
                    "veterinarian-services",
                    "checkout"
                  ]
                }
              }
            }
          }
        ]
      },
      "SeedUser": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "username",
          "password",
          "role",
          "displayName"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "username": {
            "type": "string",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "description": "Plain-text demo password"
          },
          "role": {
            "enum": [
              "veterinarian",
              "customer",
              "administrator"
            ]
          },
          "roles": {
            "$ref": "#/components/schemas/Roles"
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "customerId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "veterinarianId": {
            "$ref": "#/components/schemas/Uuid"
          }
        }
      }
    }
  }
}
