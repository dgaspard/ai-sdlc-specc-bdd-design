{
  "openapi": "3.1.0",
  "info": {
    "title": "Fake payment provider",
    "version": "1.0.0",
    "description": "Deterministic stand-in for a card processor (spec/fakes/payment). The mock method token decides the outcome: fake-card-approve (or any token starting with fake-card-approve) authorizes, fake-card-decline declines, fake-card-error returns 500. A repeated attemptId returns the original result without a new authorization (D-12). Test endpoints exist only when PETCLINIC_TEST_ENDPOINTS=enabled."
  },
  "paths": {
    "/health": {
      "get": { "responses": { "200": { "description": "Ready", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } } } } }
    },
    "/authorize": {
      "post": {
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthorizeRequest" } } } },
        "responses": {
          "200": { "description": "Authorized or declined", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthorizeResult" } } } },
          "400": { "description": "Invalid request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "409": { "description": "attemptId reused with different input", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "500": { "description": "Simulated provider failure (fake-card-error)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/test/reset": {
      "post": { "responses": { "204": { "description": "All calls and results cleared" } } }
    },
    "/test/calls": {
      "get": { "responses": { "200": { "description": "Every request received, in order", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CallLog" } } } } } }
    }
  },
  "components": {
    "schemas": {
      "Health": { "type": "object", "required": ["status"], "properties": { "status": { "const": "ok" } } },
      "AuthorizeRequest": {
        "type": "object", "additionalProperties": false,
        "required": ["attemptId", "amount", "currency", "mockMethodReference", "purpose"],
        "properties": {
          "attemptId": { "type": "string", "format": "uuid" },
          "amount": { "type": "integer", "minimum": 1 },
          "currency": { "const": "USD" },
          "mockMethodReference": { "type": "string", "minLength": 1, "maxLength": 100 },
          "purpose": { "enum": ["booking_fee", "visit_balance"] }
        }
      },
      "AuthorizeResult": {
        "type": "object", "additionalProperties": false,
        "required": ["attemptId", "outcome", "authorizationReference", "replayed"],
        "properties": {
          "attemptId": { "type": "string", "format": "uuid" },
          "outcome": { "enum": ["authorized", "declined"] },
          "authorizationReference": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
          "replayed": { "type": "boolean" }
        },
        "if": { "properties": { "outcome": { "const": "declined" } } },
        "then": { "properties": { "authorizationReference": { "type": "null" } } },
        "else": { "properties": { "authorizationReference": { "type": "string" } } }
      },
      "Error": { "type": "object", "required": ["error"], "properties": { "error": { "type": "string" } } },
      "CallLog": {
        "type": "object", "additionalProperties": false,
        "required": ["calls", "authorizations"],
        "properties": {
          "calls": {
            "type": "array",
            "items": {
              "type": "object", "required": ["request", "status", "replayed"],
              "properties": {
                "request": { "type": "object" },
                "status": { "type": "integer" },
                "replayed": { "type": "boolean" }
              }
            }
          },
          "authorizations": { "type": "integer", "minimum": 0, "description": "Distinct attemptIds that reached a provider decision" }
        }
      }
    }
  }
}
