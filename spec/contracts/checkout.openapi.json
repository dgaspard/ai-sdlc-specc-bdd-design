{
  "openapi": "3.1.0",
  "info": {
    "title": "Checkout service",
    "version": "1.0.0",
    "description": "Bills, promotions, and all payments. Calls VeterinarianServices (fees), Reservation (visits, completion), Customer (account changes), and the fake payment provider."
  },
  "servers": [
    {
      "url": "http://localhost:4004"
    }
  ],
  "x-service": "checkout",
  "paths": {
    "/internal/booking-fees": {
      "post": {
        "operationId": "collectBookingFee",
        "summary": "Collect the $20 booking fee for a reservation (card or cash)",
        "x-roles": [
          "service"
        ],
        "description": "Card calls the fake payment provider (purpose booking_fee); cash never does. An already-paid reservation returns the original paid result without a new authorization. 409 idempotency_conflict. D-62: keys are scoped per reservation, independently of visit-payment keys. Reusing a booking key for a visit payment is a separate request.",
        "x-features": [
          "spec/features/checkout/booking-fee.feature"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "common.openapi.json#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingFeeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authorized, declined, or cash recorded; replays return the original result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingFeeResult"
                }
              }
            }
          },
          "400": {
            "$ref": "common.openapi.json#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "common.openapi.json#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "common.openapi.json#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "common.openapi.json#/components/responses/Conflict"
          },
          "502": {
            "$ref": "common.openapi.json#/components/responses/BadGateway"
          },
          "500": {
            "$ref": "common.openapi.json#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/visits/{visitId}/checkout": {
      "post": {
        "operationId": "finalizeBill",
        "summary": "Veterinarian who performed the visit finalizes the bill",
        "x-roles": [
          "veterinarian"
        ],
        "description": "Prices performed services via VeterinarianServices, snapshots billed lines, charges the customer's account and credits the booking payment once. 409 already_finalized. 422 unknown_service. 403 not_assigned_veterinarian. For first finalization, the linked reservation must be Accepted and its visitId must equal this visit ID; otherwise return 409 invalid_state without saving a checkout or changing the account. An existing checkout takes precedence and returns 409 already_finalized. D-61: booking payments contribute to previouslyPaidAmount but are excluded from paymentAttempts. A zero remaining balance completes the reservation as CompletedSettled without a visit payment. D-64: Reservation 409 already_completed is success for an identical completion; Customer 409 already_applied is a failure, since it does not establish that the amount matches.",
        "x-features": [
          "spec/features/checkout/finalize-bill.feature"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "visitId",
            "in": "path",
            "required": true,
            "description": "Visit id",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "domain.openapi.json#/components/schemas/CheckoutRead"
                }
              }
            }
          },
          "401": {
            "$ref": "common.openapi.json#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "common.openapi.json#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "common.openapi.json#/components/responses/NotFound"
          },
          "409": {
            "$ref": "common.openapi.json#/components/responses/Conflict"
          },
          "422": {
            "$ref": "common.openapi.json#/components/responses/Unprocessable"
          },
          "502": {
            "$ref": "common.openapi.json#/components/responses/BadGateway"
          },
          "500": {
            "$ref": "common.openapi.json#/components/responses/InternalServerError"
          }
        }
      },
      "get": {
        "operationId": "getCheckoutForVisit",
        "summary": "Get the checkout for a visit",
        "x-roles": [
          "veterinarian",
          "customer",
          "service",
          "administrator"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "visitId",
            "in": "path",
            "required": true,
            "description": "Visit id",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "domain.openapi.json#/components/schemas/CheckoutRead"
                }
              }
            }
          },
          "401": {
            "$ref": "common.openapi.json#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "common.openapi.json#/components/responses/NotFound"
          },
          "500": {
            "$ref": "common.openapi.json#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/checkouts": {
      "get": {
        "operationId": "listCheckouts",
        "summary": "List checkouts (customers see only their own)",
        "x-roles": [
          "veterinarian",
          "customer",
          "service"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "customerId",
            "in": "query",
            "required": false,
            "description": "Filter by customer",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "domain.openapi.json#/components/schemas/CheckoutRead"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "common.openapi.json#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "common.openapi.json#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/checkouts/{checkoutId}": {
      "get": {
        "operationId": "getCheckout",
        "summary": "Get a checkout",
        "x-roles": [
          "veterinarian",
          "customer",
          "service",
          "administrator"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "checkoutId",
            "in": "path",
            "required": true,
            "description": "Checkout id",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "domain.openapi.json#/components/schemas/CheckoutRead"
                }
              }
            }
          },
          "401": {
            "$ref": "common.openapi.json#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "common.openapi.json#/components/responses/NotFound"
          },
          "500": {
            "$ref": "common.openapi.json#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/checkouts/{checkoutId}/promotion": {
      "post": {
        "operationId": "applyPromotion",
        "summary": "Veterinarian who performed the visit applies the visit's one promotion",
        "x-roles": [
          "veterinarian",
          "administrator"
        ],
        "description": "409 already_applied or nothing_owed. Promotions are final: no update or delete operation exists (405). Bringing the balance to $0 completes the reservation as settled with no payment authorization. GAP-08: this operation's assigned-veterinarian restriction (403 not_assigned_veterinarian) was not previously documented here or covered by any scenario in promotion.feature — being made explicit now alongside the MVP-02A admin-bypass work, not a new restriction. MVP-02A (D-41, D-47): a caller with the administrator role bypasses the assigned-veterinarian check and may apply a promotion on any visit; the visit's veterinarianId attribution is unaffected by who applied the promotion — an administrator never changes or substitutes for that attribution (only a veterinarian can, via reassignVeterinarian, D-48). D-65: amount is required and must be at least 1 cent; zero or missing amount returns 400 validation_error with no stored promotion or downstream account change. D-59: if the discount succeeds but Reservation completion fails, return 502 dependency_failed; the bill and Customer retain the discount. No automatic recovery. D-64: Reservation 409 already_completed is success for an identical completion; Customer 409 already_applied is a failure, since it does not establish that the amount matches.",
        "x-features": [
          "spec/features/checkout/promotion.feature"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "checkoutId",
            "in": "path",
            "required": true,
            "description": "Checkout id",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PromotionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Applied; remaining balance never below $0",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "domain.openapi.json#/components/schemas/CheckoutRead"
                }
              }
            }
          },
          "400": {
            "$ref": "common.openapi.json#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "common.openapi.json#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "common.openapi.json#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "common.openapi.json#/components/responses/NotFound"
          },
          "409": {
            "$ref": "common.openapi.json#/components/responses/Conflict"
          },
          "502": {
            "$ref": "common.openapi.json#/components/responses/BadGateway"
          },
          "500": {
            "$ref": "common.openapi.json#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/checkouts/{checkoutId}/payments": {
      "post": {
        "operationId": "payVisitBalance",
        "summary": "Pay part or all of one visit's remaining balance by card",
        "x-roles": [
          "customer",
          "veterinarian"
        ],
        "description": "Accept a positive amount up to the current remaining balance. Credit only authorized amounts, once per payment reference. Partial success completes as CompletedOutstanding; clearing the balance completes as CompletedSettled. Declines leave the balance unchanged. Serialize concurrent payments for a checkout so total credits never exceed its amount owed after discount. Identical same-key retries replay the original attempt without another authorization or credit, including after later payments; changed input returns 409 idempotency_conflict. A new key after settlement returns 409 already_settled. Amount above current balance returns 422 invalid_amount before authorization. 502 authorized_completion_failed when authorization succeeded but a later update failed (manual recovery; never reported as settled or declined). D-61/D-62: card and cash share one key scope per checkout. Cross-method reuse is 409 idempotency_conflict. A successful replay returns the original bill snapshot and attempt, changing only replayed to true, even after later payments or promotions. D-63: a failed follow-up after authorization is retained; the same-key retry returns the identical 502 problem including paymentAttemptId, without authorization, credit, or completion retries. D-64: Reservation 409 already_completed is success for an identical completion; Customer 409 already_applied is a failure, since it does not establish that the amount matches.",
        "x-features": [
          "spec/features/checkout/visit-payment.feature",
          "spec/features/checkout/payment-idempotency.feature"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "checkoutId",
            "in": "path",
            "required": true,
            "description": "Checkout id",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "common.openapi.json#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authorized or declined (declines are results, not errors); replays return the original result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResult"
                }
              }
            }
          },
          "400": {
            "$ref": "common.openapi.json#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "common.openapi.json#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "common.openapi.json#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "common.openapi.json#/components/responses/NotFound"
          },
          "409": {
            "$ref": "common.openapi.json#/components/responses/Conflict"
          },
          "422": {
            "$ref": "common.openapi.json#/components/responses/Unprocessable"
          },
          "502": {
            "$ref": "common.openapi.json#/components/responses/BadGateway"
          },
          "500": {
            "$ref": "common.openapi.json#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/checkouts/{checkoutId}/cash-payments": {
      "post": {
        "operationId": "recordCashPayment",
        "summary": "Veterinarian who performed the visit records part or all of the balance paid in cash",
        "x-roles": [
          "veterinarian",
          "administrator"
        ],
        "description": "Never calls the fake payment provider. Accept positive amounts up to the current balance; partial payment completes as CompletedOutstanding, clearing the balance as CompletedSettled. Serialize with card payments to prevent overcollection. Repeated key returns the original result and credits once. An identical same-key retry returns the original attempt and result with replayed=true, even after settlement; no additional credit or completion is sent. Changed input under the same key returns 409 idempotency_conflict before checking current balance. A new key against zero remaining balance returns 409 already_settled. An amount above the remaining balance returns 422 invalid_amount. Business-rule rejections before accepting cash create no payment attempt. GAP-08: this operation's assigned-veterinarian restriction (403 not_assigned_veterinarian) was not previously documented here or covered by any scenario in visit-payment.feature — being made explicit now alongside the MVP-02A admin-bypass work, not a new restriction. MVP-02A (D-41): a caller with the administrator role bypasses the assigned-veterinarian check and may record cash on any visit. Same open attribution question as applyPromotion and recordVisit — see docs/mvp-02a-planning.md. D-59: accepted cash followed by a failed account/completion update returns 502 authorized_completion_failed with paymentAttemptId. D-61/D-62: share the card-payment key scope per checkout; cross-method reuse is 409 idempotency_conflict. Replay the original bill snapshot and attempt, changing only replayed to true. D-63: replay a failed follow-up as the identical 502 problem without repeating account/completion work. D-64: Reservation 409 already_completed is success for an identical completion; Customer 409 already_applied is a failure, since it does not establish that the amount matches.",
        "x-features": [
          "spec/features/checkout/visit-payment.feature",
          "spec/features/checkout/payment-idempotency.feature"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "checkoutId",
            "in": "path",
            "required": true,
            "description": "Checkout id",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "common.openapi.json#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CashPaymentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResult"
                }
              }
            }
          },
          "400": {
            "$ref": "common.openapi.json#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "common.openapi.json#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "common.openapi.json#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "common.openapi.json#/components/responses/NotFound"
          },
          "409": {
            "$ref": "common.openapi.json#/components/responses/Conflict"
          },
          "422": {
            "$ref": "common.openapi.json#/components/responses/Unprocessable"
          },
          "502": {
            "$ref": "common.openapi.json#/components/responses/BadGateway"
          },
          "500": {
            "$ref": "common.openapi.json#/components/responses/InternalServerError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "BookingFeeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reservationId",
          "customerId",
          "amount",
          "currency",
          "method"
        ],
        "properties": {
          "reservationId": {
            "type": "string",
            "format": "uuid"
          },
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "const": 2000
          },
          "currency": {
            "const": "USD"
          },
          "method": {
            "enum": [
              "card",
              "cash"
            ]
          },
          "mockMethodReference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "recordedByVeterinarianId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "method": {
                  "const": "card"
                }
              }
            },
            "then": {
              "required": [
                "mockMethodReference"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "method": {
                  "const": "cash"
                }
              }
            },
            "then": {
              "required": [
                "recordedByVeterinarianId"
              ]
            }
          }
        ]
      },
      "BookingFeeResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reservationId",
          "paid",
          "attempt",
          "replayed"
        ],
        "properties": {
          "reservationId": {
            "type": "string",
            "format": "uuid"
          },
          "paid": {
            "type": "boolean"
          },
          "paymentId": {
            "type": "string",
            "format": "uuid",
            "description": "Present when paid"
          },
          "attempt": {
            "$ref": "domain.openapi.json#/components/schemas/PaymentAttempt"
          },
          "replayed": {
            "type": "boolean"
          }
        }
      },
      "PromotionRequest": {
        "description": "The applying veterinarian comes from the token.",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "amount": {
            "$ref": "domain.openapi.json#/components/schemas/UsdCents",
            "minimum": 1
          }
        },
        "required": [
          "amount"
        ]
      },
      "PaymentRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "amount",
          "mockMethodReference"
        ],
        "properties": {
          "amount": {
            "type": "integer",
            "minimum": 1,
            "description": "Must not exceed the remaining balance (422 invalid_amount otherwise)"
          },
          "mockMethodReference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      "CashPaymentRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "amount"
        ],
        "properties": {
          "amount": {
            "type": "integer",
            "minimum": 1,
            "description": "Must not exceed the remaining balance"
          }
        }
      },
      "PaymentResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "checkout",
          "attempt",
          "replayed"
        ],
        "properties": {
          "checkout": {
            "$ref": "domain.openapi.json#/components/schemas/CheckoutRead"
          },
          "attempt": {
            "$ref": "domain.openapi.json#/components/schemas/PaymentAttempt"
          },
          "replayed": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
