{
  "openapi": "3.1.0",
  "info": {
    "title": "PetClinic Domain Contracts",
    "version": "0.1.0",
    "description": "Specification-first domain schemas. These components do not imply implemented endpoints."
  },
  "paths": {},
  "components": {
    "schemas": {
      "Uuid": {
        "type": "string",
        "format": "uuid"
      },
      "UtcTimestamp": {
        "type": "string",
        "format": "date-time"
      },
      "UsdCents": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "Currency": {
        "type": "string",
        "const": "USD"
      },
      "Address": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "street",
          "city",
          "state",
          "postalCode"
        ],
        "properties": {
          "street": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "secondLine": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "city": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "state": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "postalCode": {
            "type": "string",
            "pattern": "^[0-9]{5}(?:-[0-9]{4})?$"
          }
        }
      },
      "Contact": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "phone",
          "relationship"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "phone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "relationship": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      "Billing": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "billingAddress"
        ],
        "properties": {
          "mockMethodReference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "billingAddress": {
            "$ref": "#/components/schemas/Address"
          }
        }
      },
      "InsurancePolicy": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "policyNumber",
          "coveredPetIds"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "policyNumber": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "coveredPetIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/Uuid"
            }
          }
        }
      },
      "ServiceReference": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "$ref": "#/components/schemas/Uuid"
        }
      },
      "ReservationState": {
        "type": "string",
        "enum": [
          "Requested",
          "Accepted",
          "Denied",
          "Canceled",
          "CompletedSettled",
          "CompletedOutstanding"
        ]
      },
      "PaymentPurpose": {
        "type": "string",
        "enum": [
          "booking_fee",
          "visit_balance"
        ]
      },
      "PaymentOutcome": {
        "type": "string",
        "enum": [
          "authorized",
          "declined",
          "cash_recorded"
        ]
      },
      "CustomerFields": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "lastName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "phoneNumber": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          },
          "emergencyContact": {
            "$ref": "#/components/schemas/Contact"
          },
          "secondaryContact": {
            "$ref": "#/components/schemas/Contact"
          },
          "billing": {
            "$ref": "#/components/schemas/Billing"
          },
          "insurance": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InsurancePolicy"
            }
          },
          "preferredVeterinarianId": {
            "$ref": "#/components/schemas/Uuid",
            "description": "Veterinarian chosen at profile creation (D-17); default for new reservation requests, which may override it."
          }
        },
        "description": "Shared Customer properties with no unknown-field restriction; Create and Read add required fields and forbid unknown fields."
      },
      "CustomerCreate": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CustomerFields"
          }
        ],
        "unevaluatedProperties": false,
        "required": [
          "firstName",
          "lastName",
          "phoneNumber",
          "address",
          "emergencyContact",
          "preferredVeterinarianId"
        ]
      },
      "CustomerRegistration": {
        "type": "object",
        "additionalProperties": false,
        "required": ["username", "password", "profile", "pets"],
        "properties": {
          "username": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S"},
          "password": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S"},
          "profile": {
            "allOf": [{"$ref": "#/components/schemas/CustomerCreate"}],
            "required": ["insurance", "secondaryContact", "billing"],
            "properties": {
              "insurance": {"minItems": 1},
              "billing": {"required": ["mockMethodReference", "billingAddress"]}
            }
          },
          "pets": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "name", "type", "breed", "estimatedBirthDate"],
              "properties": {
                "id": {"$ref": "#/components/schemas/Uuid"},
                "name": {"type": "string", "minLength": 1, "maxLength": 100},
                "type": {"type": "string", "minLength": 1, "maxLength": 100},
                "breed": {"type": "string", "minLength": 1, "maxLength": 100},
                "estimatedBirthDate": {"type": "string", "format": "date"}
              }
            }
          }
        },
        "description": "Atomic self-registration. Initial pet UUIDs are supplied by the caller so insurance.coveredPetIds can reference them in the same request; they must be distinct and unused. Customer/user IDs and pet ownership are server assigned. Every insurance reference must point to an initial pet. Reject future birth dates and an unknown preferred veterinarian. All profile information is required at registration; no deferred profile-completion flow."
      },
      "CustomerUpdate": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "firstName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "lastName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "phoneNumber": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          },
          "emergencyContact": {
            "$ref": "#/components/schemas/Contact"
          },
          "secondaryContact": {
            "$ref": "#/components/schemas/Contact"
          },
          "billing": {
            "$ref": "#/components/schemas/Billing"
          },
          "insurance": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InsurancePolicy"
            }
          },
          "preferredVeterinarianId": {
            "$ref": "#/components/schemas/Uuid"
          }
        }
      },
      "CustomerRead": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CustomerFields"
          },
          {
            "type": "object",
            "required": [
              "id",
              "pets",
              "insurance",
              "outstandingBalance",
              "accountEntries"
            ],
            "properties": {
              "id": {
                "$ref": "#/components/schemas/Uuid"
              },
              "pets": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/PetRead"
                }
              },
              "insurance": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/InsurancePolicy"
                }
              },
              "outstandingBalance": {
                "$ref": "#/components/schemas/UsdCents"
              },
              "accountEntries": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/AccountEntryRead"
                }
              }
            }
          }
        ],
        "unevaluatedProperties": false,
        "required": [
          "firstName",
          "lastName",
          "phoneNumber",
          "address",
          "emergencyContact",
          "preferredVeterinarianId"
        ],
        "description": "Customer with pets and account entries. Reservations and visits reference the customer and are served by Reservation (D-38)."
      },
      "PetFields": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "breed": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "estimatedBirthDate": {
            "type": "string",
            "format": "date"
          },
          "ownerId": {
            "$ref": "#/components/schemas/Uuid"
          }
        },
        "description": "Shared Pet properties with no unknown-field restriction; Create and Read add required fields and forbid unknown fields."
      },
      "PetCreate": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PetFields"
          }
        ],
        "unevaluatedProperties": false,
        "required": [
          "name",
          "type",
          "breed",
          "estimatedBirthDate",
          "ownerId"
        ]
      },
      "PetUpdate": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "breed": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "estimatedBirthDate": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "PetRead": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PetFields"
          },
          {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "$ref": "#/components/schemas/Uuid"
              }
            }
          }
        ],
        "unevaluatedProperties": false,
        "required": [
          "name",
          "type",
          "breed",
          "estimatedBirthDate",
          "ownerId"
        ],
        "description": "Pet profile. Visit history is served by Reservation (GET /visits?petId=) (D-38)."
      },
      "VeterinarianFields": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "lastName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "officeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "description": "Shared Veterinarian properties with no unknown-field restriction; Create and Read add required fields and forbid unknown fields."
      },
      "VeterinarianCreate": {
        "allOf": [
          {
            "$ref": "#/components/schemas/VeterinarianFields"
          }
        ],
        "unevaluatedProperties": false,
        "required": [
          "firstName",
          "lastName",
          "officeId"
        ]
      },
      "VeterinarianUpdate": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "firstName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "lastName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "officeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      "VeterinarianRead": {
        "allOf": [
          {
            "$ref": "#/components/schemas/VeterinarianFields"
          },
          {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "$ref": "#/components/schemas/Uuid"
              }
            }
          }
        ],
        "unevaluatedProperties": false,
        "required": [
          "firstName",
          "lastName",
          "officeId"
        ]
      },
      "ReservationFields": {
        "type": "object",
        "properties": {
          "customerId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "petId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "veterinarianId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "scheduledStart": {
            "$ref": "#/components/schemas/UtcTimestamp"
          },
          "scheduledEnd": {
            "$ref": "#/components/schemas/UtcTimestamp"
          },
          "requestedServices": {
            "$ref": "#/components/schemas/ServiceReference"
          }
        },
        "description": "Shared Reservation properties with no unknown-field restriction; Create and Read add required fields and forbid unknown fields."
      },
      "ReservationCreate": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ReservationFields"
          }
        ],
        "unevaluatedProperties": false,
        "required": [
          "customerId",
          "petId",
          "veterinarianId",
          "scheduledStart",
          "scheduledEnd",
          "requestedServices"
        ]
      },
      "ReservationUpdate": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "scheduledStart": {
            "$ref": "#/components/schemas/UtcTimestamp"
          },
          "scheduledEnd": {
            "$ref": "#/components/schemas/UtcTimestamp"
          },
          "requestedServices": {
            "$ref": "#/components/schemas/ServiceReference"
          }
        }
      },
      "ReservationRead": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ReservationFields"
          },
          {
            "type": "object",
            "required": [
              "id",
              "requestedAt",
              "acceptedAt",
              "bookingFeeAmount",
              "bookingFeePaid",
              "bookingPaymentId",
              "reservationState",
              "visitId",
              "denialReason"
            ],
            "properties": {
              "id": {
                "$ref": "#/components/schemas/Uuid"
              },
              "requestedAt": {
                "$ref": "#/components/schemas/UtcTimestamp"
              },
              "acceptedAt": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/UtcTimestamp"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "bookingFeeAmount": {
                "$ref": "#/components/schemas/UsdCents"
              },
              "bookingFeePaid": {
                "type": "boolean"
              },
              "bookingPaymentId": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/Uuid"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reservationState": {
                "$ref": "#/components/schemas/ReservationState"
              },
              "visitId": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/Uuid"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "denialReason": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Null unless Denied. Automatic outstanding-balance denials use exactly \"Please pay your full balance of $X\", where X is the customer's total outstanding balance formatted like 1,234.50 (D-20, D-27)."
              }
            }
          }
        ],
        "unevaluatedProperties": false,
        "required": [
          "customerId",
          "petId",
          "veterinarianId",
          "scheduledStart",
          "scheduledEnd",
          "requestedServices"
        ]
      },
      "VisitFields": {
        "type": "object",
        "properties": {
          "reservationId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "customerId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "petId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "veterinarianId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "performedServices": {
            "$ref": "#/components/schemas/ServiceReference"
          },
          "clinicalNotes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "diagnoses": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "medications": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "followUpNotes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "startedAt": {
            "$ref": "#/components/schemas/UtcTimestamp"
          },
          "endedAt": {
            "$ref": "#/components/schemas/UtcTimestamp"
          }
        },
        "description": "Shared Visit properties with no unknown-field restriction; Create and Read add required fields and forbid unknown fields."
      },
      "VisitCreate": {
        "allOf": [
          {
            "$ref": "#/components/schemas/VisitFields"
          }
        ],
        "unevaluatedProperties": false,
        "required": [
          "reservationId",
          "customerId",
          "petId",
          "veterinarianId",
          "performedServices",
          "clinicalNotes",
          "diagnoses",
          "medications",
          "startedAt"
        ]
      },
      "VisitUpdate": {
        "type": "object",
        "description": "Assigned-veterinarian clinical-text correction of a completed visit. References, performed services, timestamps, and finalized billing are immutable.",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "clinicalNotes": {
            "type": "string",
            "pattern": "\\S",
            "minLength": 1,
            "maxLength": 10000
          },
          "diagnoses": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "medications": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "followUpNotes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "VisitRead": {
        "allOf": [
          {
            "$ref": "#/components/schemas/VisitFields"
          },
          {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "$ref": "#/components/schemas/Uuid"
              }
            }
          }
        ],
        "unevaluatedProperties": false,
        "required": [
          "reservationId",
          "customerId",
          "petId",
          "veterinarianId",
          "performedServices",
          "clinicalNotes",
          "diagnoses",
          "medications",
          "startedAt"
        ]
      },
      "VeterinarianServiceFields": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "feeAmount": {
            "$ref": "#/components/schemas/UsdCents"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          }
        },
        "description": "Shared VeterinarianService properties with no unknown-field restriction; Create and Read add required fields and forbid unknown fields."
      },
      "VeterinarianServiceCreate": {
        "allOf": [
          {
            "$ref": "#/components/schemas/VeterinarianServiceFields"
          }
        ],
        "unevaluatedProperties": false,
        "required": [
          "name",
          "feeAmount",
          "currency"
        ]
      },
      "VeterinarianServiceUpdate": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "feeAmount": {
            "$ref": "#/components/schemas/UsdCents"
          }
        }
      },
      "VeterinarianServiceRead": {
        "allOf": [
          {
            "$ref": "#/components/schemas/VeterinarianServiceFields"
          },
          {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "$ref": "#/components/schemas/Uuid"
              }
            }
          }
        ],
        "unevaluatedProperties": false,
        "required": [
          "name",
          "feeAmount",
          "currency"
        ]
      },
      "BilledLine": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "serviceId",
          "description",
          "priceAmount"
        ],
        "properties": {
          "serviceId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "priceAmount": {
            "$ref": "#/components/schemas/UsdCents"
          }
        }
      },
      "BilledLineCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "serviceId",
          "description",
          "priceAmount"
        ],
        "properties": {
          "serviceId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "priceAmount": {
            "$ref": "#/components/schemas/UsdCents"
          }
        }
      },
      "BilledLineUpdate": {
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 0,
        "description": "Finalized billed lines are immutable."
      },
      "BilledLineRead": {
        "$ref": "#/components/schemas/BilledLine"
      },
      "AccountEntry": {
        "type": "object",
        "additionalProperties": false,
        "description": "Balance = amountOwed - amountCredited - amountDiscounted; never negative (D-26).",
        "required": [
          "id",
          "customerId",
          "visitId",
          "amountOwed",
          "amountCredited",
          "amountDiscounted",
          "currency",
          "paymentIds"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "customerId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "visitId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "amountOwed": {
            "$ref": "#/components/schemas/UsdCents"
          },
          "amountCredited": {
            "$ref": "#/components/schemas/UsdCents"
          },
          "amountDiscounted": {
            "$ref": "#/components/schemas/UsdCents",
            "description": "Applied promotion amount for this visit; 0 when none."
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          },
          "paymentIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/Uuid"
            }
          }
        }
      },
      "PaymentAttempt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attemptId",
          "customerId",
          "reservationId",
          "purpose",
          "amount",
          "currency",
          "outcome",
          "timestamp"
        ],
        "properties": {
          "attemptId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "customerId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "reservationId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "visitId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "purpose": {
            "$ref": "#/components/schemas/PaymentPurpose"
          },
          "amount": {
            "$ref": "#/components/schemas/UsdCents"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          },
          "mockMethodReference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "outcome": {
            "$ref": "#/components/schemas/PaymentOutcome"
          },
          "timestamp": {
            "$ref": "#/components/schemas/UtcTimestamp"
          },
          "authorizationReference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "recordedByVeterinarianId": {
            "$ref": "#/components/schemas/Uuid"
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "outcome"
              ],
              "properties": {
                "outcome": {
                  "const": "declined"
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "authorizationReference"
                ]
              }
            }
          }
        ]
      },
      "CheckoutFields": {
        "type": "object",
        "properties": {
          "customerId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "reservationId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "visitId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          },
          "billedLines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/BilledLineCreate"
            }
          },
          "totalAmount": {
            "$ref": "#/components/schemas/UsdCents"
          },
          "previouslyPaidAmount": {
            "$ref": "#/components/schemas/UsdCents"
          },
          "remainingBalance": {
            "$ref": "#/components/schemas/UsdCents"
          }
        },
        "description": "Shared Checkout properties with no unknown-field restriction; Create and Read add required fields and forbid unknown fields."
      },
      "CheckoutCreate": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CheckoutFields"
          }
        ],
        "unevaluatedProperties": false,
        "required": [
          "customerId",
          "reservationId",
          "visitId",
          "currency",
          "billedLines",
          "totalAmount",
          "previouslyPaidAmount",
          "remainingBalance"
        ]
      },
      "CheckoutUpdate": {
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 0
      },
      "CheckoutRead": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CheckoutFields"
          },
          {
            "type": "object",
            "required": [
              "id",
              "paymentAttempts",
              "promotion"
            ],
            "properties": {
              "id": {
                "$ref": "#/components/schemas/Uuid"
              },
              "paymentAttempts": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/PaymentAttempt"
                }
              },
              "promotion": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/PromotionRead"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "At most one promotion per visit (D-26)."
              }
            }
          }
        ],
        "unevaluatedProperties": false,
        "required": [
          "customerId",
          "reservationId",
          "visitId",
          "currency",
          "billedLines",
          "totalAmount",
          "previouslyPaidAmount",
          "remainingBalance"
        ],
        "description": "remainingBalance = max(0, totalAmount - previouslyPaidAmount - promotion.appliedAmount)."
      },
      "AccountEntryCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "customerId",
          "visitId",
          "amountOwed",
          "currency"
        ],
        "properties": {
          "customerId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "visitId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "amountOwed": {
            "$ref": "#/components/schemas/UsdCents"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          }
        }
      },
      "AccountEntryUpdate": {
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 0
      },
      "AccountEntryRead": {
        "$ref": "#/components/schemas/AccountEntry"
      },
      "PaymentAttemptCreate": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PaymentAttempt"
          }
        ],
        "description": "Created payment attempts are validated by purpose and outcome rules in addition to this structural schema."
      },
      "PaymentAttemptUpdate": {
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 0
      },
      "PaymentAttemptRead": {
        "$ref": "#/components/schemas/PaymentAttempt"
      },
      "PromotionCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "appliedByVeterinarianId"
        ],
        "description": "Veterinarian applies one promotion to a visit's finalized checkout (D-26).",
        "properties": {
          "appliedByVeterinarianId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "amount": {
            "$ref": "#/components/schemas/UsdCents",
            "default": 0,
            "description": "Discount the veterinarian enters; defaults to $0."
          }
        }
      },
      "PromotionUpdate": {
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 0,
        "description": "Applied promotions are immutable."
      },
      "PromotionRead": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "checkoutId",
          "visitId",
          "appliedByVeterinarianId",
          "amount",
          "appliedAmount",
          "appliedAt"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "checkoutId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "visitId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "appliedByVeterinarianId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "amount": {
            "$ref": "#/components/schemas/UsdCents",
            "description": "Amount entered."
          },
          "appliedAmount": {
            "$ref": "#/components/schemas/UsdCents",
            "description": "min(amount, remaining balance at application); the portion actually deducted."
          },
          "appliedAt": {
            "$ref": "#/components/schemas/UtcTimestamp"
          }
        }
      }
    },
