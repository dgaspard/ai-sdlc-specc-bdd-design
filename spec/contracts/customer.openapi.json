{
  "openapi": "3.1.0",
  "info": {
    "title": "Customer service",
    "version": "1.0.0",
    "description": "Customer and pet profiles, account balance, booking eligibility, and demo login. Calls no other service."
  },
  "servers": [
    {
      "url": "http://localhost:4001"
    }
  ],
  "x-service": "customer",
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Log in with a seeded demo user",
        "x-roles": [
          "anonymous"
        ],
        "x-features": [
          "spec/features/customer/login.feature"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "auth.openapi.json#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "auth.openapi.json#/paths/~1auth~1login/post/responses/200"
          },
          "400": {
            "$ref": "common.openapi.json#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "auth.openapi.json#/paths/~1auth~1login/post/responses/401"
          }
        }
      }
    },
    "/customers": {
      "post": {
        "operationId": "createCustomer",
        "summary": "Create a customer profile (veterinarians only)",
        "x-roles": [
          "veterinarian"
        ],
        "description": "preferredVeterinarianId must be a seeded veterinarian (400 validation_error otherwise).",
        "x-features": [
          "spec/features/customer/customer-profile.feature"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "domain.openapi.json#/components/schemas/CustomerCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "domain.openapi.json#/components/schemas/CustomerRead"
                }
              }
            }
          },
          "400": {
            "$ref": "common.openapi.json#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "common.openapi.json#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "common.openapi.json#/components/responses/Forbidden"
          }
        }
      },
      "get": {
        "operationId": "listCustomers",
        "summary": "List customers",
        "x-roles": [
          "veterinarian"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "domain.openapi.json#/components/schemas/CustomerRead"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "common.openapi.json#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "common.openapi.json#/components/responses/Forbidden"
          }
        }
      }
    },
    "/customers/{customerId}": {
      "get": {
        "operationId": "getCustomer",
        "summary": "Get a customer profile",
        "x-roles": [
          "veterinarian",
          "customer",
          "service"
        ],
        "x-features": [
          "spec/features/customer/customer-profile.feature"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "customerId",
            "in": "path",
            "required": true,
            "description": "Customer id",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "domain.openapi.json#/components/schemas/CustomerRead"
                }
              }
            }
          },
          "401": {
            "$ref": "common.openapi.json#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "common.openapi.json#/components/responses/NotFound"
          }
        }
      },
      "patch": {
        "operationId": "updateCustomer",
        "summary": "Update a customer profile (outstanding balance is not editable)",
        "x-roles": [
          "veterinarian",
          "customer"
        ],
        "x-features": [
          "spec/features/customer/customer-profile.feature"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "customerId",
            "in": "path",
            "required": true,
            "description": "Customer id",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "domain.openapi.json#/components/schemas/CustomerUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "domain.openapi.json#/components/schemas/CustomerRead"
                }
              }
            }
          },
          "400": {
            "$ref": "common.openapi.json#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "common.openapi.json#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "common.openapi.json#/components/responses/NotFound"
          }
        }
      }
    },
    "/customers/{customerId}/pets": {
      "post": {
        "operationId": "addPet",
        "summary": "Add a pet to a customer",
        "x-roles": [
          "veterinarian",
          "customer"
        ],
        "description": "estimatedBirthDate after the clinic clock's date is rejected (400 validation_error).",
        "x-features": [
          "spec/features/customer/pets.feature"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "customerId",
            "in": "path",
            "required": true,
            "description": "Customer id",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PetCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "domain.openapi.json#/components/schemas/PetRead"
                }
              }
            }
          },
          "400": {
            "$ref": "common.openapi.json#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "common.openapi.json#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "common.openapi.json#/components/responses/NotFound"
          }
        }
      },
      "get": {
        "operationId": "listPets",
        "summary": "List a customer's pets",
        "x-roles": [
          "veterinarian",
          "customer",
          "service"
        ],
        "x-features": [
          "spec/features/customer/pets.feature"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "customerId",
            "in": "path",
            "required": true,
            "description": "Customer id",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "domain.openapi.json#/components/schemas/PetRead"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "common.openapi.json#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "common.openapi.json#/components/responses/NotFound"
          }
        }
      }
    },
    "/pets/{petId}": {
      "get": {
        "operationId": "getPet",
        "summary": "Get a pet",
        "x-roles": [
          "veterinarian",
          "customer",
          "service"
        ],
        "x-features": [
          "spec/features/customer/pets.feature"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "description": "Pet id",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "domain.openapi.json#/components/schemas/PetRead"
                }
              }
            }
          },
          "401": {
            "$ref": "common.openapi.json#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "common.openapi.json#/components/responses/NotFound"
          }
        }
      }
    },
    "/customers/{customerId}/eligibility": {
      "get": {
        "operationId": "getEligibility",
        "summary": "Check booking eligibility (eligible only when nothing is owed)",
        "x-roles": [
          "veterinarian",
          "customer",
          "service"
        ],
        "x-features": [
          "spec/features/customer/booking-eligibility.feature"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "customerId",
            "in": "path",
            "required": true,
            "description": "Customer id",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Eligibility"
                }
              }
            }
          },
          "401": {
            "$ref": "common.openapi.json#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "common.openapi.json#/components/responses/NotFound"
          }
        }
      }
    },
    "/customers/{customerId}/account": {
      "get": {
        "operationId": "getAccount",
        "summary": "Get account entries and outstanding balance",
        "x-roles": [
          "veterinarian",
          "customer",
          "service"
        ],
        "x-features": [
          "spec/features/customer/account-balance.feature"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "customerId",
            "in": "path",
            "required": true,
            "description": "Customer id",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "401": {
            "$ref": "common.openapi.json#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "common.openapi.json#/components/responses/NotFound"
          }
        }
      }
    },
    "/internal/customers/{customerId}/pets/{petId}/ownership": {
      "get": {
        "operationId": "checkOwnership",
        "summary": "Confirm whether a customer owns a pet",
        "x-roles": [
          "service"
        ],
        "description": "404 only when the customer does not exist; an unknown or other customer's pet returns owned=false.",
        "x-features": [
          "spec/features/customer/pets.feature"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "customerId",
            "in": "path",
            "required": true,
            "description": "Customer id",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "description": "Pet id",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ownership"
                }
              }
            }
          },
          "401": {
            "$ref": "common.openapi.json#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "common.openapi.json#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "common.openapi.json#/components/responses/NotFound"
          }
        }
      }
    },
    "/internal/customers/{customerId}/account-changes": {
      "post": {
        "operationId": "applyAccountChange",
        "summary": "Apply a charge, credit, or discount for one visit",
        "x-roles": [
          "service"
        ],
        "description": "409 already_applied: repeated charge for a visit, repeated credit for a paymentId, or a second discount. 422 invalid_amount: the change would make the balance negative (never clamped).",
        "x-features": [
          "spec/features/customer/account-balance.feature"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "customerId",
            "in": "path",
            "required": true,
            "description": "Customer id",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountChange"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Applied; returns the visit's entry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "domain.openapi.json#/components/schemas/AccountEntryRead"
                }
              }
            }
          },
          "400": {
            "$ref": "common.openapi.json#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "common.openapi.json#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "common.openapi.json#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "common.openapi.json#/components/responses/NotFound"
          },
          "409": {
            "$ref": "common.openapi.json#/components/responses/Conflict"
          },
          "422": {
            "$ref": "common.openapi.json#/components/responses/Unprocessable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "PetCreateRequest": {
        "description": "ownerId comes from the path.",
        "allOf": [
          {
            "$ref": "domain.openapi.json#/components/schemas/PetFields"
          }
        ],
        "required": [
          "name",
          "type",
          "breed",
          "estimatedBirthDate"
        ],
        "not": {
          "required": [
            "ownerId"
          ]
        },
        "unevaluatedProperties": false
      },
      "Eligibility": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "customerId",
          "eligible",
          "outstandingBalance"
        ],
        "properties": {
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "eligible": {
            "type": "boolean"
          },
          "outstandingBalance": {
            "$ref": "domain.openapi.json#/components/schemas/UsdCents"
          }
        }
      },
      "Ownership": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "customerId",
          "petId",
          "owned"
        ],
        "properties": {
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "petId": {
            "type": "string",
            "format": "uuid"
          },
          "owned": {
            "type": "boolean"
          }
        }
      },
      "AccountChange": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "visitId",
          "type",
          "amount",
          "currency"
        ],
        "properties": {
          "visitId": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "enum": [
              "charge",
              "credit",
              "discount"
            ]
          },
          "amount": {
            "type": "integer",
            "minimum": 0
          },
          "currency": {
            "const": "USD"
          },
          "paymentId": {
            "type": "string",
            "format": "uuid",
            "description": "Required for credit; each payment credits once"
          }
        },
        "if": {
          "properties": {
            "type": {
              "const": "credit"
            }
          }
        },
        "then": {
          "required": [
            "paymentId"
          ]
        }
      },
      "Account": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "customerId",
          "outstandingBalance",
          "entries"
        ],
        "properties": {
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "outstandingBalance": {
            "$ref": "domain.openapi.json#/components/schemas/UsdCents"
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "domain.openapi.json#/components/schemas/AccountEntryRead"
            }
          }
        }
      }
    }
  }
}
