{
  "openapi": "3.1.0",
  "info": {
    "title": "PetClinic shared API components",
    "version": "1.0.0",
    "description": "Shared by every service contract (SPEC-04). Errors use RFC 9457 problem details (application/problem+json) with a stable `code`. Every operation declares `x-roles`: the token roles allowed to call it (auth-contract.md). Paths under /internal/ accept only role `service`. Status codes: 400 malformed or schema-invalid; 401 missing/invalid/expired token; 403 role not allowed or not the assigned veterinarian; 404 not found or another customer's record; 409 state conflict; 422 business-rule rejection; 502 dependency failure."
  },
  "paths": {},
  "components": {
    "securitySchemes": {
      "bearer": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key", "in": "header", "required": true,
        "description": "UUID v4 per intentional payment attempt; retransmissions reuse it (D-12).",
        "schema": { "type": "string", "format": "uuid" }
      }
    },
    "schemas": {
      "ProblemCode": {
        "enum": [
          "validation_error", "unauthenticated", "forbidden", "not_found",
          "not_assigned_veterinarian", "invalid_state", "invalid_slot", "past_start", "pet_conflict",
          "already_started", "already_recorded", "already_finalized", "already_applied",
          "already_completed", "already_settled", "nothing_owed", "unknown_service",
          "idempotency_conflict", "invalid_amount", "booking_payment_declined",
          "dependency_failed", "authorized_completion_failed"
        ]
      },
      "Problem": {
        "type": "object",
        "required": ["type", "title", "status", "code"],
        "properties": {
          "type": { "type": "string", "description": "URI reference; `about:blank` is acceptable" },
          "title": { "type": "string", "minLength": 1 },
          "status": { "type": "integer", "minimum": 400, "maximum": 599 },
          "detail": { "type": "string" },
          "instance": { "type": "string" },
          "code": { "$ref": "#/components/schemas/ProblemCode" },
          "unknownServiceIds": { "type": "array", "items": { "type": "string" }, "description": "Present when code is unknown_service" },
          "paymentAttemptId": { "type": "string", "format": "uuid", "description": "Present when code is authorized_completion_failed" }
        }
      }
    },
    "responses": {
      "BadRequest": { "description": "Malformed or schema-invalid request (validation_error)", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "Unauthorized": { "description": "Missing, invalid, or expired token (unauthenticated)", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "Forbidden": { "description": "Role not allowed (forbidden) or not the assigned veterinarian (not_assigned_veterinarian)", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "NotFound": { "description": "Not found, or another customer's record (not_found)", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "Conflict": { "description": "State conflict (invalid_state, already_*, idempotency_conflict, nothing_owed)", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "Unprocessable": { "description": "Business-rule rejection (invalid_slot, past_start, pet_conflict, unknown_service, invalid_amount, booking_payment_declined)", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "BadGateway": { "description": "Dependency failure (dependency_failed, authorized_completion_failed)", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
    }
  }
}
