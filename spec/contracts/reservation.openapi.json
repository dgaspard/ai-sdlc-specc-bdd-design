  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Slot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "veterinarianId",
          "start",
          "end"
        ],
        "properties": {
          "veterinarianId": {
            "type": "string",
            "format": "uuid"
          },
          "start": {
            "$ref": "domain.openapi.json#/components/schemas/UtcTimestamp"
          },
          "end": {
            "$ref": "domain.openapi.json#/components/schemas/UtcTimestamp"
          }
        }
      },
      "Availability": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "slots"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Slot"
            }
          }
        },
        "description": "Only open slots: weekday hours outside lunch, not before the clinic clock, not taken by an Accepted reservation."
      },
      "AcceptRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bookingFee"
        ],
        "properties": {
          "bookingFee": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "method",
                  "mockMethodReference"
                ],
                "properties": {
                  "method": {
                    "const": "card"
                  },
                  "mockMethodReference": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "method"
                ],
                "properties": {
                  "method": {
                    "const": "cash"
                  }
                }
              }
            ]
          }
        }
      },
      "VisitRecordRequest": {
        "description": "Reservation, customer, pet, and veterinarian come from the reservation and token. MVP-02A (D-46): clinicalNotes is no longer required — closing/recording a visit without it is allowed and returns notesMissing: true rather than a rejection. MVP-02A (D-47): when the caller is an administrator bypassing the assigned-veterinarian check (not also the assigned veterinarian), clinicalNotes, diagnoses, medications, and followUpNotes must all be absent; supplying any of them is rejected as 400 validation_error. Not expressible as a static schema constraint here (it depends on caller role and assignment) — enforced in the implementation and covered by feature scenarios.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "performedServices"
        ],
        "properties": {
          "performedServices": {
            "$ref": "domain.openapi.json#/components/schemas/ServiceReference"
          },
          "clinicalNotes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "pattern": "\\S"
          },
          "diagnoses": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "medications": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "followUpNotes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "endedAt": {
            "$ref": "domain.openapi.json#/components/schemas/UtcTimestamp"
          }
        }
      },
      "CompleteRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "financialOutcome"
        ],
        "properties": {
          "financialOutcome": {
            "enum": [
              "settled",
              "outstanding"
            ]
          }
        }
      }
    }
  }
}
